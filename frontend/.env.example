# API Configuration
VITE_API_URL=[YOUR_API_URL]  # Example: https://api.yourdomain.com/v1
VITE_AUTH_TOKEN_KEY=[YOUR_AUTH_TOKEN_KEY]

# API Endpoints
VITE_ENTERPRISES_ENDPOINT=[YOUR_ENTERPRISES_ENDPOINT]  # Example: /enterprises
VITE_LOAN_PRODUCTS_ENDPOINT=[YOUR_LOAN_PRODUCTS_ENDPOINT]  # Example: /loan-products
VITE_AUTH_ENDPOINT=[YOUR_AUTH_ENDPOINT]  # Example: /auth

# Feature Flags
VITE_ENABLE_DEBUG=[DEBUG_MODE]  # Example: false for production
VITE_API_TIMEOUT=[TIMEOUT_IN_MS]  # Example: 30000

# Security
VITE_MAX_UPLOAD_SIZE=[MAX_SIZE_IN_BYTES]  # Example: 5242880 (5MB)

# Note: This is an example configuration file.
# Create a copy named .env and update the values according to your environment.
# DO NOT commit the actual .env file to version control.
# Make sure to replace all placeholder values with secure production values.
